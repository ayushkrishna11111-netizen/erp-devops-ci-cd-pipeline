# ERP DevOps CI/CD Pipeline — environment template
# Copy to .env and fill in real values.  .env is gitignored; never commit it.
#   cp .env.example .env

# ---- Postgres (compose `db` service) ----
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=erp_db

# ---- Host port mappings (change only if a port is already in use) ----
# If you have a native Postgres installed it already owns 5432 and the
# container's mapping will be shadowed by it. Use 5544 in that case.
DB_PORT=5432
SERVER_PORT=5000
CLIENT_PORT=3000

# ---- API (compose `server` service) ----
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://erp_user:CHANGE_ME_local_only@db:5432/erp_db
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Release traceability (injected by CI; harmless defaults locally) ----
APP_VERSION=dev
COMMIT_SHA=local
GIT_BRANCH=local
# ISO timestamp of the image build; leave unset locally (reported as unknown).
# BUILD_TIMESTAMP=

# ---- CI → API deployment records ----
# Shared secret CI sends as X-Deploy-Token to POST /api/deployments.
# Required in staging/production (writes are refused without it).
DEPLOY_API_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---- Database lock guardrails (docs/DATABASE_LOCK_GUARD.md) ----
# How long a migration may WAIT for a lock it needs before aborting. Live
# transactions are blocked for at most this long. Postgres treats 0 as
# wait-forever, so 0 is rejected - pick a small number instead.
MIGRATION_LOCK_TIMEOUT_MS=5000
# Hard ceiling on one migration statement (a full-table rewrite on a large
# table should be split, not allowed to run unbounded).
MIGRATION_STATEMENT_TIMEOUT_MS=300000
# If the migration runner dies mid-transaction, Postgres reclaims its
# session after this long instead of leaving an idle-in-transaction blocker.
MIGRATION_IDLE_TX_TIMEOUT_MS=60000
# Application-query guardrails (applied to every pool connection): kill a
# single runaway query after this long, and kill a session that sits idle
# inside a transaction. 0 disables either.
APP_STATEMENT_TIMEOUT_MS=30000
APP_IDLE_TX_TIMEOUT_MS=60000

# ---- Data and startup behaviour ----
# Apply pending server/db/*.sql migrations on startup (Postgres only).
MIGRATE_ON_START=true
# Seed generated sample data into EMPTY tables on first start. Set false for real data.
SEED_DEMO_DATA=true
# Create demo logins (admin@/manager@/user@erp.local). Ignored in production
# unless explicitly set to true — the passwords are published in the README.
SEED_DEMO_USERS=true
# memory = no database at all (data lost on restart). Default: postgres.
# DATA_STORE=memory
# Never set in normal operation; bypasses the additive-migration check.
# ALLOW_DESTRUCTIVE_MIGRATIONS=false
